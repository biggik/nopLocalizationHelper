<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<Description>A library that assists with management of nopCommerce locale string resources (netstandard2.0)</Description>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<Version>0.9.0</Version>
		<Authors>Status ehf, Birgir Kristmannsson</Authors>
		<Product>nopLocalizationHelper</Product>
		<Copyright>Status ehf</Copyright>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageProjectUrl>https://github.com/biggik/nopLocalizationHelper</PackageProjectUrl>
		<Company>Status ehf</Company>
		<RepositoryUrl>https://github.com/biggik/nopLocalizationHelper</RepositoryUrl>
		<PackageTags>nopCommerce, localization, locale</PackageTags>
		<RunPostBuildEvent>Always</RunPostBuildEvent>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\LICENSE">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.ValueTuple" Version="4.5.0" />
	</ItemGroup>

	<Target Name="PostPackNugetDeploy" AfterTargets="Pack" Condition="'$(Configuration)' == 'Release'">
		<PropertyGroup>
			<_PublishBat>$(MSBuildThisFileDirectory)..\publish.bat</_PublishBat>
			<_Nupkg>$(PackageOutputAbsolutePath)$(PackageId).$(PackageVersion).nupkg</_Nupkg>
		</PropertyGroup>
		<Error Condition="!Exists('$(_PublishBat)')" Text="publish.bat was not found at $(_PublishBat)." />
		<Error Condition="!Exists('$(_Nupkg)')" Text="Package was not found at $(_Nupkg)." />
		<Exec Command="&quot;$(_PublishBat)&quot; &quot;$(_Nupkg)&quot;" />
	</Target>
</Project>
